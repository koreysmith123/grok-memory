[Unit]
Description=Grok Memory daemon
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory="__INSTALL_DIR__"
EnvironmentFile="__INSTALL_DIR__/.env"
ExecStart=/usr/bin/env node "__INSTALL_DIR__/dist/cli.js" daemon
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
